# Copy this file to `.env` and adjust the values.

# Comma-separated list of allowed frontend origins (CORS).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: path to a cookies.txt file (Netscape format) for platforms that
# require login (private Instagram posts, age-restricted content, ...).
# Leave empty to disable.
COOKIE_FILE=

# Timeout (seconds) for yt-dlp extraction.
EXTRACT_TIMEOUT=30

# Limits for bulk (ZIP) downloads.
MAX_ZIP_ITEMS=20
MAX_ZIP_MB=500

# Max source duration (seconds) allowed for GIF conversion.
MAX_GIF_SECONDS=30

# Absolute path to ffmpeg (needed for GIF/MP3, DASH merge, and /api/process jobs).
# Leave empty to use whatever is on PATH.
FFMPEG_BIN=

# Scratch directory for jobs and ZIPs (wiped on startup).
# Empty = <backend>/tmp
TMP_DIR=

# Processing jobs (/api/process).
MAX_CONCURRENT_JOBS=1
MAX_INPUT_MB=300
MAX_DURATION_MIN=15
JOB_TIMEOUT_SEC=600
JOB_RATE_LIMIT=5
JOB_RATE_WINDOW_SEC=600
JOB_TTL_SEC=900
